{
  "schemaVersion": 2,
  "note": "種(species)マスタ。v2でルーレットを『縦式パネル・リール』(オレカバトル式)に変更。reel=縦一列の行動パネル(上から順)。各panelは star(★ランク1-4)とcategory。戦闘では縦スクロールし停止ラインのパネルを実行。中身はレベルアップでランダムに変化する(growthSpec参照)。所持個体は別途IndexedDBで管理(speciesId参照+個体ごとのreel状態/ロック/Lv/性格/継承)。",
  "ranks": ["G", "F", "E", "D", "C", "B", "A", "S", "SS"],
  "attributes": ["fire", "water", "wind", "earth", "light", "dark", "none"],
  "families": ["beast", "dragon", "magic", "plant", "material", "aqua", "bird", "demon", "spirit", "machine"],
  "categories": ["attack", "magic", "heal", "buff", "debuff", "defense", "support", "ultimate", "miss"],

  "rouletteSpec": {
    "style": "vertical_reel",
    "description": "円形回転ではなく縦式リール。各モンスターのreel(パネル列)が上下スクロールし、中央の停止ラインに来たパネルの行動を実行。スロットマシンの1リール。",
    "panelCountInitial": 4,
    "panelCountMax": 8,
    "stop": {
      "auto": "おまかせ(既定): 自動で減速・停止。停止位置は均等寄り抽選。",
      "manual": "ストップ(任意ON): スクロール中タップで停止。狙いパネルを引きにいける/外すリスクあり。"
    },
    "missPanel": "category=miss は止まると行動失敗。低ランクに混ざる。育成で別の技に化ける『種枠』。",
    "implementationNote": "停止パネルは事前抽選で確定し、演出(translateY)は後追い。結果と表示を分離。"
  },

  "growthSpec": {
    "description": "オレカバトル式ランダム成長。レベルアップごとにreelの1パネルがランダムで別の技/上位の技に変化する。",
    "perLevelUp": {
      "mutations": 1,
      "rule": "ロックされていないパネルから1枚を抽選し、変化。変化先は同speciesのfamilyGrowthPool(同属性優先)から抽選。",
      "upgradeBias": "現パネルより同等以上の★が出やすい(ミス→★、★→★★ のように育つ)。",
      "rareJump": { "chance": 0.08, "effect": "飛び級(★→★★★)や必殺パネル(★★★★)出現。当たり個体になる。" }
    },
    "playerControl": {
      "lock": "気に入ったパネルをロックして変化対象から除外。",
      "reroll": "リロール素材で直近の変化を振り直す(事故救済)。",
      "frameTemplate": "型テンプレ(攻撃寄り/補助寄り/必殺特化)で変化プールの重みを方針指定可。"
    }
  },

