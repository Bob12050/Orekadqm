{
  "schemaVersion": 1,
  "note": "配合ルール。決定順: 1)specialRecipesに合致→固定結果 2)合致しなければgenericで系統・ランク算出→候補プールから抽選。継承(スキル/ステ/属性/性格)はinheritanceで処理。",

  "generic": {
    "description": "汎用配合。親2体の系統相性表で子系統を決定、ランクは平均+ボーナスで算出。",
    "rankOrder": ["G", "F", "E", "D", "C", "B", "A", "S", "SS"],
    "rankFormula": "childRankIndex = floor((parentA.rankIndex + parentB.rankIndex) / 2) + rankBonus",
    "rankBonus": {
      "sameSpecies": 1,
      "highAffinityFamilies": 1,
      "bothMaxLevel": 1,
      "maxTotalBonus": 2,
      "note": "条件を満たすほど上位ランクへ。合計ボーナス上限2段階。"
    },
    "familyMatrix": {
