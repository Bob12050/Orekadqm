        "ゆうかん": { "hp": 0.05, "atk": 0.03, "tameability": 0.0 }
      }
    },
    "trait": {
      "rule": "個性(小特性)は低確率で親から継承。",
      "inheritChance": 0.2,
      "examples": ["会心+5%", "毒耐性", "先制+", "スカウト成功率+", "経験値+"]
    },
    "lost": ["親2体は消費(消滅)", "選ばなかった継承スキル", "親の現在Lv"],
    "kept": ["選んだ継承スキル(最大2)", "ステ継承ボーナス", "属性・性格の一部", "親の図鑑記録(残る)"]
  },

