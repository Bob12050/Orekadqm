      "material":{ "beast": "beast", "dragon": "dragon", "magic": "magic", "plant": "plant", "material": "material", "aqua": "material", "bird": "material", "demon": "material", "spirit": "material", "machine": "machine" },
      "aqua":    { "beast": "aqua", "dragon": "dragon", "magic": "magic", "plant": "aqua", "material": "material", "aqua": "aqua", "bird": "aqua", "demon": "demon", "spirit": "aqua", "machine": "machine" },
      "bird":    { "beast": "bird", "dragon": "dragon", "magic": "magic", "plant": "plant", "material": "material", "aqua": "aqua", "bird": "bird", "demon": "demon", "spirit": "spirit", "machine": "machine" },
      "demon":   { "beast": "demon", "dragon": "demon", "magic": "demon", "plant": "demon", "material": "material", "aqua": "demon", "bird": "demon", "demon": "demon", "spirit": "demon", "machine": "machine" },
      "spirit":  { "beast": "beast", "dragon": "dragon", "magic": "spirit", "plant": "spirit", "material": "material", "aqua": "aqua", "bird": "spirit", "demon": "demon", "spirit": "spirit", "machine": "machine" },
      "machine": { "beast": "machine", "dragon": "dragon", "magic": "machine", "plant": "material", "material": "machine", "aqua": "machine", "bird": "machine", "demon": "machine", "spirit": "machine", "machine": "machine" }
    },
    "highAffinityPairs": [
      ["beast", "dragon"], ["aqua", "dragon"], ["magic", "spirit"], ["plant", "spirit"], ["material", "machine"], ["demon", "magic"]
    ],
    "candidateSelection": "子系統×子ランク帯のspeciesプールから、引き継ぎ要素と乱数で1種を抽選。複数候補はプレビューで提示。"
  },

  "inheritance": {
    "skill": {
      "rule": "親A・親Bの習得スキルからプレイヤーが最大2つ選択して継承。子のルーレット枠に初期セット。",
      "maxInherit": 2,
      "crossFamilyPenalty": "系統不一致スキルは継承コスト増 or 一部不可(無双化防止)。"
    },
    "stats": {
      "rule": "子初期ステ = 種基礎値 + 親平均ステ × 継承係数。ランク上限でクランプ。",
      "coefficient": 0.15
    },
    "attribute": {
      "rule": "子属性=種固有属性を基本。親属性から確率でサブ属性(耐性)付与。",
      "subAttributeChance": 0.35
    },
    "personality": {
      "rule": "性格は確率で親から継承、それ以外は新規抽選。",
      "inheritChance": 0.5,
      "personalities": ["やんちゃ", "おっとり", "こうけつ", "きまぐれ", "まじめ", "ゆうかん"],
